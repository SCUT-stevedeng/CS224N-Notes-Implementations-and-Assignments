    "import torch\n",
    "import torch.nn as nn\n",
    "class PositionalEncoding(nn.Module):\n",
    "    def __init__(self,X, num_hiddens, max_length):\n",
    "        for pos,token in enumerate(X):\n",
    "            torch.sin(pos/torch.pow(10000,))"
